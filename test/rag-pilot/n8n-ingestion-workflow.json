      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "dbc4ef05-990c-4477-b76f-0ae5f8292123",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        180
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "9bb8828a-42da-4ba6-9d3f-e441a2a9a66c",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\"service_url\":\"http://rag-ingestion:18592\"}",
        "options": {}
      },
      "notes": "本地调试可改为 http://127.0.0.1:18592；Docker 中应使用处理服务内网地址。"
    },
    {
      "id": "ac0ddd71-b5b9-41a4-92d9-4db880ed968e",
      "name": "Submit job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        },
        "method": "POST",
        "url": "={{ $('Configuration').first().json.service_url + '/v1/jobs' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"action\":\"scan\"}"
      },
      "notes": "请在此节点选择 Header Auth 凭据：Authorization=Bearer <令牌>。提交失败不会自动重试，避免重复任务。"
    },
    {
      "id": "d2f9a2f9-b29f-4af6-b6e8-f3e6b84ad324",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        660,
        0
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 5,
        "unit": "seconds"
      }
    },
    {
      "id": "b9ab65b4-b35e-461b-8207-8e3923ba8c73",
      "name": "Job status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        },
        "url": "={{ $('Configuration').first().json.service_url + '/v1/jobs/' + $('Submit job').first().json.job_id }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "notes": "请选择与 Submit job 相同的 Header Auth 凭据。"
    },
    {
      "id": "27b4f341-ab0c-42a4-9c26-9504b1677358",
